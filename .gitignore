.DS_Store
Thumbs.db
*.swp
*.tmp

# Stow folds ~/.config into this repo, so any tool configured there writes its
# runtime state straight into the working tree. Keep the config, drop the rest.
*.log
*.sock
stow/*/.config/**/session.json
stow/*/.config/**/.plugins.lock

# gh keeps its token in the keychain, but falls back to writing it here in
# plaintext whenever the keyring is unavailable.
stow/*/.config/gh/hosts.yml

